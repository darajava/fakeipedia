# Existing database and generation provider settings
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GEMINI_API_KEY=
OPENAI_API_KEY=

# Canonical public origin. Use http://localhost:3000 during local development.
APP_URL=http://localhost:3000

# Clerk: create an app, enable Email verification link for sign-in/sign-up.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe: start with test keys and two one-time Price IDs.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ARTICLE_PRICE_ID=
STRIPE_CREDIT_PACK_PRICE_ID=
CREDIT_PACK_QUANTITY=10
# Explicit launch switch; leave false while testing.
STRIPE_ALLOW_LIVE=false
