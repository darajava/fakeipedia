# Existing database and generation provider settings
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GEMINI_API_KEY=
OPENAI_API_KEY=

# Canonical public origin. Use http://localhost:3000 during local development.
APP_URL=http://localhost:3000

# Stripe: one multi-currency, one-time Price with USD, GBP and EUR options,
# USD/EUR at 90 minor units and GBP at 85 minor units ($0.90 / £0.85 / €0.90).
BILLING_ENABLED=false
# Accepts secret (sk_...) or restricted (rk_...) API keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ARTICLE_PRICE_ID=
# Explicit launch switch; leave false while testing.
STRIPE_ALLOW_LIVE=false
